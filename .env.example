# Copy this file to .env and fill in the values from your Supabase project.

# --- Read by the app (bundled into the client) ---
# Supabase dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# --- Read only by the Node scripts in scripts/ (migrations, introspection, smoke tests) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Session pooler" (port 5432)
DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres

# Optional: only needed to seed the workouts table with scripts/seed-workouts.mjs after RLS is enabled.
# Supabase dashboard -> Project Settings -> API -> service_role. Never prefix this with EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
